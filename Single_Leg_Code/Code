int min_tibia = [];
int max_tibia = [];

enum STATE_names //names for states, for code clarity
{
STATE_home_all,
STATE_max_coxa,
STATE_min_coxa,
STATE_home_coxa,
STATE_max_femur,
STATE_min_femur,
STATE_home_femur,
STATE_max_tibia,
STATE_min_tibia,
STATE_home_tibia,
STATE_idle
};

unsigned long previousMillis = 0;  //variables set to run timings
unsigned long waitTime = 0;

STATE_names STATE = STATE_idle;  //default state

void Run_Leg_Setup() //opens setup function
{

  if (STATE == STATE_idle) //skips rest of function if state is idle
  {
    return; 
  }


  if (millis() - previousMillis >= waitTime) //checks timing
  {
    previousMillis = millis(); //sets new time

    switch(STATE) //state machine
    {      
      case STATE_home_all:  //state to set all leg components to home position
        legServo.WritePos(1, home_coxa, setup_speed, setup_acceleration);
        legServo.WritePos(2, home_femur, setup_speed, setup_acceleration);
        legServo.WritePos(3, home_tibia, setup_speed, setup_acceleration);
        waitTime = 2000;
        STATE = STATE_max_coxa;
        break;

      case STATE_max_coxa:  //state to set coxa to max
        legServo.WritePos(1, max_coxa, setup_speed, setup_acceleration);
        waitTime = 1000;
        STATE = STATE_min_coxa;
        break;

      case STATE_min_coxa:  //state to set coxa to min
        legServo.WritePos(1, min_coxa, setup_speed, setup_acceleration);
        waitTime = 1000;
        STATE = STATE_home_coxa;
        break;

      case STATE_home_coxa:  //state to set coxa to home
        legServo.WritePos(1, home_coxa, setup_speed, setup_acceleration);
        waitTime = 2000;
        STATE = STATE_max_femur;
        break;

      case STATE_max_femur:  //state to set femur to max
        legServo.WritePos(2, max_femur, setup_speed, setup_acceleration);
        waitTime = 1000;
        STATE = STATE_min_femur;
        break;

      case STATE_min_femur:  //state to set femur to min
        legServo.WritePos(2, min_femur, setup_speed, setup_acceleration); // Fixed missing comma here
        waitTime = 1000;
        STATE = STATE_home_femur;
        break;

      case STATE_home_femur:  //state to set femur to home
        legServo.WritePos(2, home_femur, setup_speed, setup_acceleration);
        waitTime = 2000;
        STATE = STATE_max_tibia;
        break;

      case STATE_max_tibia:  //state to set tibia to max
        legServo.WritePos(3, max_tibia, setup_speed, setup_acceleration);
        waitTime = 1000;
        STATE = STATE_min_tibia;
        break;

      case STATE_min_tibia:  //state to set tibia to min
        legServo.WritePos(3, min_tibia, setup_speed, setup_acceleration);
        waitTime = 1000;
        STATE = STATE_home_tibia;
        break;

      case STATE_home_tibia:  //state to set tibia to home
        legServo.WritePos(3, home_tibia, setup_speed, setup_acceleration);
        waitTime = 2000;
        STATE = STATE_idle;
        break;
        
      case STATE_idle:  //state to break the sequence upon it's completion
        break;
    }
  }
}

//main loop. everything should come back to here
